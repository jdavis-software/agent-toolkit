            "api-check"
          ]
        }
      ],
      "inputDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "capabilities": [
        "edit"
      ],
      "effects": [
        "local-write"
      ],
      "phase": "implementation",
      "tokenBudget": 100,
      "maxAttempts": 2,
      "resources": {
        "cpu": 1
      },
      "requiresApproval": false
    },
    {
      "id": "ui",
      "goal": "Produce the synthetic ui fixture",
      "owns": [
        "ui/"
      ],
      "dependsOn": [],
