        {
          "id": "ui-check",
          "argv": [
            "node",
            "--version"
          ]
        }
      ],
      "acceptance": [
        {
          "id": "ui-criterion",
          "expect": "Synthetic expected artifact is present",
          "checkIds": [
            "ui-check"
          ]
        }
      ],
      "inputDigest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
