{
  "schemaVersion": 1,
  "runId": "synthetic-example",
  "policy": {
    "maxConcurrent": 3,
    "reservedReviewSlots": 1,
    "maxTokens": 1000,
    "allowedEffects": [
      "read",
      "local-write"
    ],
    "resources": {
      "cpu": 3
    }
  },
