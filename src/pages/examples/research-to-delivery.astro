---
import Base from '../../layouts/Base.astro';
import { withBase, repository } from '../../lib/paths';
import explanation from '../../../examples/publicationcheck/explanation.json';
import storyboard from '../../../examples/publicationcheck/storyboard.json';
---
<Base title="Research to Delivery example" description="An inspectable synthetic example: source-linked explanation, a timed product storyboard and independent artifact checks." active="bundles">
  <div class="container showcase">
    <a class="back-link" href={withBase('bundles/research-to-delivery/')}>← Research to Delivery bundle</a>
    <header class="showcase-heading">
      <p class="eyebrow">WORKED EXAMPLE / SYNTHETIC EVIDENCE</p>
      <h1>From evidence to<br /><span>a useful artifact.</span></h1>
      <p>Investigate the change. Explain the system. Plan the story. Check what you ship.</p>
    </header>
    <div class="notice"><strong>A demonstration, not a product claim.</strong> The observations, assets and storyboard below are synthetic fixtures. They show how to preserve evidence and uncertainty—not a completed customer study, product video or agent-host evaluation.</div>
    <section aria-labelledby="explain-title" class="example-section">
      <p class="eyebrow">01 / EXPLAIN THE SYSTEM</p><h2 id="explain-title">Make every connection inspectable.</h2>
      <p>{explanation.description}</p>
      <ol class="proof-flow" aria-label="Synthetic pipeline stages">{explanation.nodes.map((node,i)=><li class="proof-card"><span class="ordinal">0{i+1}</span><h3>{node.label}</h3><p>{node.description}</p></li>)}</ol>
      <details class="evidence-details" open><summary>Relationship evidence and text explanation</summary>
        <ul>{explanation.edges.map(edge=><li><strong>{edge.meaning}</strong><p>{edge.citations[0].quote}</p><span class="evidence-label">EXACT EXCERPT / SEMANTIC REVIEW STILL REQUIRED</span></li>)}</ul>
      </details>
      <a class="text-link" href={`${repository}/blob/main/examples/publicationcheck/explanation.json`}>Inspect the explanation contract ↗</a>
    </section>
    <section aria-labelledby="story-title" class="example-section">
      <p class="eyebrow">02 / PLAN THE STORY</p><h2 id="story-title">Fifteen seconds. One honest message.</h2>
      <p>Three contiguous shots at 30 frames per second. The roadmap stays labeled as a roadmap.</p>
      <div class="shots">{storyboard.shots.map((shot,i)=><article class="shot-card"><div class="shot-top"><span>{shot.startFrame/storyboard.fps}–{shot.endFrame/storyboard.fps}s</span><span class="tag">{shot.presentedAs === 'planned' ? 'Planned feature' : 'Fixture capability'}</span></div><h3>{shot.purpose}</h3><p>{storyboard.captions[i].text}</p><span class="evidence-label">SYNTHETIC ASSET / NOT A RENDERED VIDEO</span></article>)}</div>
      <a class="text-link" href={`${repository}/blob/main/examples/publicationcheck/storyboard.json`}>Inspect the shot and caption contract ↗</a>
    </section>
    <section class="example-section" aria-labelledby="check-title">
      <p class="eyebrow">03 / CHECK THE ARTIFACT</p><h2 id="check-title">Success needs more than an exit code.</h2>
      <div class="check-grid"><div><h3>Check what the record says.</h3><p>Reject an unknown event date, unrun reproduction, unsupported diagram edge, or planned feature presented as available.</p></div><div><h3>Inspect what was built.</h3><p>Audit local canonical URLs and links. Probe and decode short media against an independent output contract. Keep semantic review separate.</p></div></div>
      <div class="bundle-command"><div><strong>Run the original fixture demonstration</strong><p>No network requests, model calls or publication.</p><code>python3 examples/publicationcheck/demo.py</code></div><a class="text-link" href={withBase('tools/publicationcheck/')}>Explore Publicationcheck →</a></div>
    </section>
  </div>
</Base>
<style>
.showcase{max-width:1160px;padding-top:42px;padding-bottom:65px}.showcase-heading{max-width:850px;margin-bottom:30px}.showcase-heading h1{font-size:clamp(38px,5vw,66px);font-weight:550;line-height:1.08;margin-bottom:24px}.showcase-heading h1 span{color:var(--accent)}:global(html[data-theme=light]) .showcase-heading h1 span{color:#477731}.showcase-heading>p:last-child{font-size:18px;max-width:700px}.example-section{padding:44px 0;border-bottom:1px solid var(--line)}.example-section h2{font-size:30px;font-weight:550}.example-section>p{max-width:820px}.proof-flow,.shots{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;padding:0;list-style:none;margin:28px 0}.proof-card,.shot-card{min-width:0;border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:24px}.ordinal{display:inline-block;font:12px monospace;color:var(--quiet);margin-bottom:26px}.proof-card h3{font-size:23px}.proof-card p,.shot-card p{font-size:14px;margin-bottom:0}.evidence-details{border:1px solid var(--line);border-radius:10px;margin:22px 0;padding:20px}.evidence-details summary{cursor:pointer;font-weight:550}.evidence-details ul{padding-left:20px}.evidence-details li{padding:17px 0}.evidence-details p{margin:9px 0;font-size:14px}.evidence-label{font:9px/1.7 monospace;letter-spacing:.7px;color:var(--quiet)}.shot-top{display:flex;justify-content:space-between;gap:10px;margin-bottom:24px;font:12px monospace;align-items:center;flex-wrap:wrap}.shot-card h3{font-size:19px;line-height:1.4}.shot-card .evidence-label{display:block;margin-top:22px}.check-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;margin-top:26px}.check-grid h3{font-size:21px}.text-link{text-decoration:underline;text-underline-offset:4px}@media(max-width:760px){.proof-flow,.shots,.check-grid{grid-template-columns:1fr}.showcase-heading>p:last-child{font-size:16px}.example-section{padding:32px 0}.example-section h2{font-size:25px}.ordinal{margin-bottom:17px}.proof-card,.shot-card{padding:22px}.evidence-details{padding:17px}.evidence-details ul{padding-left:17px}}@media print{.showcase{color:black}.proof-card,.shot-card{break-inside:avoid}.evidence-details{display:block}}
</style>
