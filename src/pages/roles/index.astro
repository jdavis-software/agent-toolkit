---
import Base from '../../layouts/Base.astro';
import { loadRoles } from '../../../tools/lib/roles.mjs';
import { withBase, repository } from '../../lib/paths';
const roles=await loadRoles();
---
<Base title="Specialist roles" active="roles" description="Eight focused specialist presets that select canonical skills, explicit outputs and useful context—not fictional expertise or new permissions.">
<div class="container">
  <section class="page-heading role-heading"><p class="eyebrow">A RESPONSIBILITY, NOT ANOTHER FRAMEWORK</p><h1>The right skills.<br/><span>A clear responsibility.</span></h1><p>{roles.length} specialist presets for building, reviewing, researching and producing. Each selects existing skills and defines the handoff. Your execution environment still owns tools and permissions.</p></section>
  <div class="role-toolbar"><label class="search-box"><span class="sr-only">Search roles</span><input type="search" id="role-search" placeholder="Find a role: frontend, review, video…" aria-controls="role-grid" /></label><button class="button secondary" id="role-reset" type="button">Reset roles</button></div>
  <p class="role-result" id="role-count" role="status">Showing {roles.length} of {roles.length} roles</p>
  <section id="role-grid" class="role-grid" aria-label="Specialist roles">
    {roles.map((r,i)=><article class="role-card" data-role-card data-search={`${r.title} ${r.kind} ${r.description}`.toLowerCase()}><div class="role-card-top"><span class="role-number">{String(i+1).padStart(2,'0')}</span><span class="tag">{r.kind}</span></div><h2><a href={withBase(`roles/${r.id}/`)}>{r.title}<span aria-hidden="true">↗</span></a></h2><p>{r.description}</p><div class="role-card-foot"><span>{r.skills.length} canonical skills</span><span>{r.requestedMode === 'read-only'?'Review / analyze':'Task-bound work'}</span></div></article>)}
  </section>
  <p id="role-empty" class="notice" hidden>No matching role. Reset to explore all eight presets.</p>
  <section class="bundle-explainer"><h2>Choose the job. Keep the skills canonical.</h2><p>A role supplies responsibility, context and expected output. A skill supplies a procedure; a tool performs an operation. None of these grants authority or starts a worker just because you select it.</p><p><code>node tools/bundle.mjs roles</code></p><a class="text-link" href={`${repository}/blob/main/docs/ROLES.md`}>Read role contracts and private binding guidance ↗</a></section>
</div>
</Base>
<script>
 const input=document.querySelector<HTMLInputElement>('#role-search');
 const reset=document.querySelector<HTMLButtonElement>('#role-reset');
 const cards=[...document.querySelectorAll<HTMLElement>('[data-role-card]')];
 const update=(changeUrl=true)=>{
  const q=(input?.value??'').trim().toLowerCase();let count=0;
  for(const card of cards){card.hidden=!(card.dataset.search??'').includes(q);if(!card.hidden)count++;}
  const status=document.querySelector('#role-count');if(status)status.textContent=`Showing ${count} of ${cards.length} roles`;
  const empty=document.querySelector<HTMLElement>('#role-empty');if(empty)empty.hidden=count!==0;
  if(changeUrl){const url=new URL(location.href);if(q)url.searchParams.set('q',input?.value??'');else url.searchParams.delete('q');history.replaceState(null,'',url);}
 };
 if(input)input.value=new URL(location.href).searchParams.get('q')??'';
 update(false);input?.addEventListener('input',()=>update());
 reset?.addEventListener('click',()=>{if(input){input.value='';update();input.focus();}});
 window.addEventListener('popstate',()=>{if(input)input.value=new URL(location.href).searchParams.get('q')??'';update(false);});
</script>
