---
import '../styles/global.css';
import { withBase, repository } from '../lib/paths';
interface Props { title: string; description?: string; active?: string; }
const { title, description = 'Practical agent skills, workflows, and developer tooling for parallel AI-assisted engineering.', active = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#111214" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
  <title>{title} · Agent Toolkit</title>
  <script is:inline>
    try {
      const saved = localStorage.getItem('agent-toolkit-theme');
      document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
    } catch { /* Storage is optional. */ }
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <header class="header">
    <a href={withBase()} class="brand" aria-label="Agent Toolkit home"><span class="brand-mark" aria-hidden="true">a/</span><span>agent<span class="brand-slash">/</span>toolkit</span></a>
    <nav aria-label="Main navigation">
      {['Skills','Tools','Workflows','About'].map(label => <a href={withBase(`${label.toLowerCase()}/`)} aria-current={active === label.toLowerCase() ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="header-actions">
      <button type="button" id="theme-toggle" class="icon-button" aria-label="Switch color theme" title="Switch color theme"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button>
      <a class="repo-link" href={repository}>GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="footer">
    <span>Agent Toolkit <span class="muted">/</span> Jordan Davis</span>
    <div><a href={withBase('about/')}>About & attribution</a><a href={`${repository}/blob/main/CONTRIBUTING.md`}>Contribute</a><a href={`${repository}/blob/main/docs/ROADMAP.md`}>Roadmap</a></div>
    <span class="footer-note">Source first. Evidence over claims.</span>
  </footer>
  <script>
    const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
    const updateLabel = () => button?.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`);
    updateLabel();
    button?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('agent-toolkit-theme',next); } catch { /* Keep working without storage. */ }
      updateLabel();
    });
  </script>
</body>
</html>
